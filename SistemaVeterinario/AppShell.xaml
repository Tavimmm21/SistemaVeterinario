<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SistemaVeterinario.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SistemaVeterinario"
    xmlns:views="clr-namespace:SistemaVeterinario.Views"
    Shell.FlyoutBehavior="Flyout"
    Shell.TabBarIsVisible="True"
    Title="Sistema Veterinário">

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#512BD4" HeightRequest="140" Padding="20">
            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                <Label Text="🐾 Sistema Veterinário"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label Text="Gestão de Clientes, Animais e Espécies"
                       FontSize="13"
                       TextColor="White" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <Grid Padding="20,12" BackgroundColor="#EEEEEE">
            <Label Text="Versão 1.0 • Projeto Acadêmico"
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="Gray" />
        </Grid>
    </Shell.FlyoutFooter>

    <FlyoutItem Title="Menu Principal" FlyoutDisplayOptions="AsMultipleItems">

        <Tab Title="Home">
            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="Clientes">
            <ShellContent
                Title="Clientes"
                ContentTemplate="{DataTemplate views:ClientesPrincipal}"
                Route="ClientesPrincipal" />
        </Tab>

        <Tab Title="Animais">
            <ShellContent
                Title="Animais"
                ContentTemplate="{DataTemplate views:AnimaisPrincipal}"
                Route="AnimaisPrincipal" />
        </Tab>

        <Tab Title="Espécies">
            <ShellContent
                Title="Espécies"
                ContentTemplate="{DataTemplate views:EspeciesPrincipal}"
                Route="EspeciesPrincipal" />
        </Tab>

        <Tab Title="Desenvolvedor">
            <ShellContent
                Title="Desenvolvedor"
                ContentTemplate="{DataTemplate views:DesenvolvedorPage}"
                Route="DesenvolvedorPage" />
        </Tab>

    </FlyoutItem>

</Shell>
