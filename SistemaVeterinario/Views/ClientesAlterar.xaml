<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemaVeterinario.Views.ClientesAlterar"
             Title=":: CLIENTE - ALTERAR ::..">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Nome" FontAttributes="Bold" />
            <Entry x:Name="EntryNome" Placeholder="Nome completo" />

            <Label Text="CPF" FontAttributes="Bold" />
            <Entry x:Name="EntryCpf" Placeholder="Somente números" Keyboard="Numeric" />

            <Label Text="Email" FontAttributes="Bold" />
            <Entry x:Name="EntryEmail" Placeholder="email@exemplo.com" Keyboard="Email" />

            <Label Text="Data de Cadastro" FontAttributes="Bold" />
            <DatePicker x:Name="DatePickerCadastro" />

            <Button Text="Salvar"
                    Clicked="OnSalvarClicked"
                    Margin="0,20,0,0" />

            <Button Text="Voltar"
                    Clicked="OnVoltarClicked"
                    BackgroundColor="Gray" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
