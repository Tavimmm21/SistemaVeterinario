<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemaVeterinario.Views.AnimaisAlterar"
             Title=":: ANIMAL - ALTERAR ::..">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Nome" FontAttributes="Bold" />
            <Entry x:Name="EntryNome" Placeholder="Nome do animal" />

            <Label Text="Apelido" FontAttributes="Bold" />
            <Entry x:Name="EntryApelido" Placeholder="Apelido (opcional)" />

            <Label Text="Data de Nascimento" FontAttributes="Bold" />
            <DatePicker x:Name="DatePickerNascimento" />

            <Label Text="Espécie" FontAttributes="Bold" />
            <Picker x:Name="PickerEspecie" Title="Selecione a espécie" />

            <Label Text="Dono (Cliente)" FontAttributes="Bold" />
            <Picker x:Name="PickerCliente" Title="Selecione o cliente" />

            <Label Text="Observações" FontAttributes="Bold" />
            <Editor x:Name="EditorObservacoes" HeightRequest="100" Placeholder="Observações (opcional)" />

            <Button Text="Salvar"
                    Clicked="OnSalvarClicked"
                    Margin="0,20,0,0" />

            <Button Text="Voltar"
                    Clicked="OnVoltarClicked"
                    BackgroundColor="Gray" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
