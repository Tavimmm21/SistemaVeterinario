<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemaVeterinario.MainPage"
             Title="Início">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,40"
            Spacing="20">

            <Label
                Text="🐾 Sistema Veterinário"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Selecione uma opção abaixo ou utilize o menu / barra inferior para navegar."
                FontSize="14"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Button
                x:Name="BtnClientes"
                Text="👤  Clientes"
                Clicked="OnClientesClicked" />

            <Button
                x:Name="BtnAnimais"
                Text="🐾  Animais"
                Clicked="OnAnimaisClicked" />

            <Button
                x:Name="BtnEspecies"
                Text="🐶  Espécies"
                Clicked="OnEspeciesClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
